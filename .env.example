# ─── Resend ──────────────────────────────────────────────────────────────
# API key (Full access, or Sending + Receiving): https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only if you create the webhook by hand. Settings → Resend webhook → Connect stores it for you.
RESEND_WEBHOOK_SECRET=

# ─── Supabase ────────────────────────────────────────────────────────────
# Project URL: Project Settings → API (or Data API)
SUPABASE_URL=https://xxxx.supabase.co
# Service-role / secret key (server-only, never exposed to the browser) — used for attachment storage
SUPABASE_SERVICE_ROLE_KEY=
# Database password you set when creating the project (raw — no URL-encoding)
SUPABASE_DB_PASSWORD=
# Region of your project, from Connect → pooler host "aws-0-<region>.pooler.supabase.com"
# e.g. ap-south-1, ap-northeast-1, us-east-1 (use the full "aws-1-<region>" if your host starts with aws-1)
SUPABASE_REGION=

# ─── App ─────────────────────────────────────────────────────────────────
# Random string, min 32 chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Vercel sends "Authorization: Bearer $CRON_SECRET" to the daily cron
CRON_SECRET=
# IANA zone used to display dates, e.g. Asia/Kolkata
APP_TIMEZONE=UTC

# ─── Free-tier guards ────────────────────────────────────────────────────
# Resend free: 100 emails/day and 3,000/month, counting sent AND received.
DAILY_SEND_CAP=95
DAILY_WARN_AT=80
MONTHLY_CAP=3000
# Copy attachments into Supabase Storage (Resend deletes them after 30 days)
ARCHIVE_ATTACHMENTS=true
# Total size of attachments on an outgoing email (Vercel body limit is 4.5 MB)
MAX_ATTACHMENT_MB=4
# Largest inbound attachment to archive
ARCHIVE_MAX_MB=10
