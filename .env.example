# EasyMail: required settings only. Everything else has sensible defaults (see README → Optional settings).

# Resend API key (Full access): https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Supabase: Project Settings → API keys / Database
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional public key. If the service-role key is empty, Storage uses this one (needs bucket policies, see README).
SUPABASE_ANON_KEY=
# Database password, as-is (no URL-encoding)
SUPABASE_DB_PASSWORD=
# From Connect → pooler host aws-0-<region>.pooler.supabase.com, e.g. ap-south-1
SUPABASE_REGION=ap-south-1

# Random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=

# Your timezone for displaying dates (IANA name)
APP_TIMEZONE=Asia/Kolkata
